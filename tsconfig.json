{
  "compilerOptions": {
    // Webpack will convert ES modules to the required format.
    "module": "esnext",
    "esModuleInterop": true,
    "target": "es2016",
    // Make it possible to gradually adopt TypeScript, or not use it at all.
    "allowJs": true,
    // Turn on stricter type checking.
    "strict": true,
    /* feature:use_vue */
    // For Vue compatibility. Can be removed when Vue is not in use.
    "noImplicitAny": false,
    /* endfeature */
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "sourceMap": true,
    "jsx": "react",
    "moduleResolution": "bundler",
    "types": ["jest"],
    "rootDir": "tbx/static_src"
  },
  "include": ["tbx/static_src"],
  "exclude": ["node_modules", "tbx/static_compiled"]
}
